VITE_API_BASE_URL=http://localhost:4000
VITE_DEV_TUNNEL=0
# Set to 1 to auto-start a Cloudflare Quick Tunnel for the Vite surface.
AEVO_DEV_TUNNEL=0
# Optional stable public hostname used by the local launcher for auth/CORS.
# AEVO_GO_TUNNEL_URL=https://go-dev.example.com
# Central Accounts broker.
VITE_ACCOUNTS_URL=http://localhost:8787
VITE_APP_ENV=development
# Live is the default: only Admin/Gateway public projections are shown.
# Use demo only for isolated UI shell work; it does not represent production data.
VITE_GO_DATA_MODE=live
# Keep legacy until the Core canonical Place projection is populated and smoke-tested.
VITE_PLACE_API_MODE=legacy
VITE_CSRF_COOKIE_NAME=aevo_go_csrf
# Optional MapLibre style URL. Defaults to OpenFreeMap Dark for development.
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
# Attribution is mandatory for the selected style/tile provider.
# VITE_MAP_STYLE_ATTRIBUTION=© OpenFreeMap · © OpenStreetMap contributors
# OpenStreetMap place layer: mock for deterministic local fixtures, remote for
# Overpass API, or disabled to use only Customer Gateway places.
# VITE_OSM_OVERPASS_MODE=mock
# VITE_OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
