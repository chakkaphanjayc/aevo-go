{
  "name": "aevo-go",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4324",
    "dev:tunnel": "AEVO_DEV_TUNNEL=1 AEVO_DEV_TUNNEL_AUTOSTART=1 vite --host 0.0.0.0 --port 4324",
    "dev:demo": "VITE_GO_DATA_MODE=demo VITE_OSM_OVERPASS_MODE=mock bun run dev",
    "build": "tsc -b && vite build",
    "build:worker": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4324",
    "preview:worker": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "cap:sync": "bun run build && cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@capacitor/core": "^7.4.4",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@tanstack/react-query": "^5.90.5",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-map-gl": "^8.1.3",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "22.18.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@cloudflare/vite-plugin": "1.57.1",
    "@cloudflare/workers-types": "5.20260922.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "5.8.2",
    "vite": "^7.1.9",
    "wrangler": "4.136.1",
    "vitest": "^3.2.4"
  }
}
